# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Canonical production Gemini model (strictly gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_ADSENSE_CLIENT_ID: Google AdSense Publisher ID (e.g. ca-pub-XXXXXXXXXXXXXXXX)
VITE_ADSENSE_CLIENT_ID="ca-pub-1925778784615690"

# Google AdMob Mobile App Credentials (used for native/mobile wrapper views)
VITE_ADMOB_APP_ID="ca-app-pub-1925778784615690~2153384953"
VITE_ADMOB_BANNER_UNIT_ID="ca-app-pub-1925778784615690/1200230084"
VITE_ADMOB_INTERSTITIAL_UNIT_ID="ca-app-pub-1925778784615690/8504005038"
VITE_ADMOB_AD_UNIT_3_ID="ca-app-pub-1925778784615690/6153173866"

# WhatsApp Business/API gateway
